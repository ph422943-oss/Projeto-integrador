const fornecedores = [];

function listarFornecedores(req, res) {
  res.writeHead(200, {
    'Content-Type': 'application/json; charset=utf-8'
  });
  res.end(JSON.stringify(fornecedores));
}

function criarFornecedor(req, res) {
  let corpo = '';

  req.on('data', parte => {
    corpo += parte;
  });

  req.on('end', () => {
    try {
      const fornecedor = JSON.parse(corpo);
      fornecedor.id = Date.now();
      fornecedores.push(fornecedor);

      res.writeHead(201, {
        'Content-Type': 'application/json; charset=utf-8'
      });
      res.end(JSON.stringify(fornecedor));
    } catch (erro) {
      res.writeHead(400);
      res.end('JSON inválido');
    }
  });
}

module.exports = {
  listarFornecedores,
  criarFornecedor
};
